      "status": "official",
      "entry": {
        "kind": "command",
        "command": ["C:/Users/17838/AppData/Roaming/npm/codex.cmd"],
        "cwd": null,
        "note": "真实调用=L3 业主；arbiter 场景 sandbox=read-only"
      },
      "health_check": {
        "kind": "file",
        "path": "C:/Users/17838/AppData/Roaming/npm/codex.cmd"
      },
      "timeout_sec": 300,
