    {
      "id": "worker-workbuddy-cli",
      "name": "WorkBuddy CLI（AI Worker，CLI 型）",
      "role": "worker",
      "type": "AI_CLI",
      "status": "official",
      "entry": {
        "kind": "command",
        "command": ["C:/Program Files/WorkBuddy/resources/app.asar.unpacked/cli/bin/codebuddy"],
        "cwd": null,
        "note": "真实调用消耗额度=L3 业主；本适配器只构造协议（stdin=goal/stdout=结果/stderr=日志）"
      },
      "health_check": {
        "kind": "file",
        "path": "C:/Program Files/WorkBuddy/resources/app.asar.unpacked/cli/bin/codebuddy"
      },
      "timeout_sec": 300,
      "adapter": "adapter-api-model",
